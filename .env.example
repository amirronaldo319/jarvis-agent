# Copy to .env.local and fill in ONLY the providers you have. Placeholders only; never commit real keys.
# A model shows "Online" when its key AND (for non-Anthropic) its model name are set. Restart `npm run dev` after editing.

# --- Anthropic (model names are built in) ---
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- OpenAI-compatible providers: set a key and the exact model name from the provider's docs ---
# OPENAI_API_KEY=
# OPENAI_MODEL=
# GOOGLE_API_KEY=
# GOOGLE_MODEL=
# XAI_API_KEY=
# XAI_MODEL=
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=

# --- Custom OpenAI-compatible endpoint (e.g. a local Ollama or a gateway). Key is optional. ---
# OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1
# OPENAI_COMPAT_MODEL=
# OPENAI_COMPAT_API_KEY=
